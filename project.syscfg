const VREF          = scripting.addModule("/ti/driverlib/VREF");
const ProjectConfig = scripting.addModule("/ti/project_config/ProjectConfig");

/**
 * Write custom configuration values to the imported modules.
 */
const divider4       = system.clockTree["PLL_CLK0_DIV"];
divider4.divideValue = 32;

const divider7       = system.clockTree["PLL_PDIV"];
divider7.divideValue = 8;

const divider9       = system.clockTree["UDIV"];
divider9.divideValue = 2;

const multiplier2         = system.clockTree["PLL_QDIV"];
multiplier2.multiplyValue = 36;

const mux8       = system.clockTree["HSCLKMUX"];
mux8.inputSelect = "HSCLKMUX_SYSPLL0";

ADC121.adcMem0chansel                    = "DL_ADC12_INPUT_CHAN_13";
ADC121.enabledInterrupts                 = ["DL_ADC12_INTERRUPT_DMA_DONE"];
ADC121.configureDMA                      = true;
ADC121.sampCnt                           = 1;
ADC121.$name                             = "ADC_Current";
ADC121.enabledDMATriggers                = ["DL_ADC12_DMA_MEM0_RESULT_LOADED"];
ADC121.adcMem0vref                       = "VREF";
ADC121.sampleTime0                       = "0.5 ms";
ADC121.repeatMode                        = true;
ADC121.sampClkDiv                        = "DL_ADC12_CLOCK_DIVIDE_32";
ADC121.peripheral.$assign                = "ADC0";
ADC121.DMA_CHANNEL.$name                 = "DMA_CH0";
ADC121.DMA_CHANNEL.configureTransferSize = true;
ADC121.DMA_CHANNEL.srcLength             = "HALF_WORD";
ADC121.DMA_CHANNEL.dstLength             = "HALF_WORD";
ADC121.DMA_CHANNEL.addressMode           = "f2b";
ADC121.DMA_CHANNEL.transferSize          = 400;

Board.configureUnused             = true;
Board.unusedDirection             = "INPUT";
Board.unusedInternalResistor      = "PULL_DOWN";
Board.peripheral.$assign          = "DEBUGSS";
Board.peripheral.swclkPin.$assign = "PA20";
Board.peripheral.swdioPin.$assign = "PA19";

COMP1.$name                          = "COMP_0";
COMP1.compMode                       = "DL_COMP_MODE_ULP";
COMP1.hysteresis                     = "DL_COMP_HYSTERESIS_30";
COMP1.vSource                        = "DL_COMP_REF_SOURCE_VREF_DAC";
COMP1.controlSelect                  = "DL_COMP_DAC_CONTROL_SW";
COMP1.terminalSelect                 = "DL_COMP_REF_TERMINAL_SELECT_NEG";
COMP1.channelEnable                  = ["POS"];
COMP1.posChannel                     = "DL_COMP_IPSEL_CHANNEL_2";
COMP1.enableWinComp                  = true;
COMP1.setDACCode0                    = 0x98;
COMP1.peripheral.$assign             = "COMP0";
COMP1.peripheral.compPinPos2.$assign = "PA14";
COMP1.compPinPos2Config.$name        = "ti_driverlib_gpio_GPIOPinGeneric0";

GPIO1.$name                           = "OLED";
GPIO1.associatedPins.create(4);
GPIO1.associatedPins[0].$name         = "DC";
GPIO1.associatedPins[0].assignedPort  = "PORTB";
GPIO1.associatedPins[0].assignedPin   = "7";
GPIO1.associatedPins[0].pin.$assign   = "PB7";
GPIO1.associatedPins[1].$name         = "RES";
GPIO1.associatedPins[1].assignedPort  = "PORTA";
GPIO1.associatedPins[1].assignedPin   = "27";
GPIO1.associatedPins[1].pin.$assign   = "PA27";
GPIO1.associatedPins[2].$name         = "CS";
GPIO1.associatedPins[2].assignedPin   = "6";
GPIO1.associatedPins[2].pin.$assign   = "PB6";
GPIO1.associatedPins[3].driveStrength = "HIGH";
GPIO1.associatedPins[3].$name         = "VCC";

GPIO2.$name                          = "LED";
GPIO2.associatedPins[0].$name        = "D3";
GPIO2.associatedPins[0].assignedPort = "PORTA";
GPIO2.associatedPins[0].assignedPin  = "3";
GPIO2.associatedPins[0].initialValue = "SET";

GPIO3.$name                         = "MOS";
GPIO3.associatedPins.create(2);
GPIO3.associatedPins[0].$name       = "SAMPLE";
GPIO3.associatedPins[0].ioStructure = "OD";
