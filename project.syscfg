GPIO2.associatedPins[0].pin.$suggestSolution     = "PA3";
OPA1.peripheral.$suggestSolution                 = "OPA0";
UART1.DMA_CHANNEL_RX.peripheral.$suggestSolution = "DMA_CH0";
